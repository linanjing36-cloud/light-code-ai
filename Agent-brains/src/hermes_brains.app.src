{application, hermes_brains,
 [{description, "Agent-brains: Hermes Agent 系统的 Erlang/OTP 编排大脑"},
  {vsn, "0.1.0"},
  {registered, [hermes_brains_sup]},
  {mod, {hermes_brains_app, []}},
  {applications, [kernel, stdlib, lager]},
  %% mnesia 不放 applications —— mnesia_store 完全掌控其生命周期:
  %% disc_copies 表要求 schema 在 disc 上, 而 create_schema 要求 mnesia 未运行。
  %% 若把 mnesia 放 applications, OTP 会先用 RAM-only schema 启动它,
  %% 后续 create_schema 失败 (already_running), create_table(disc_copies) 报 bad_type。
  %% 正确顺序: mnesia_store:init/1 -> create_schema (mnesia 未跑) -> ensure_started -> create_table(disc_copies)
  {modules, [hermes_brains_app, hermes_brains_sup, agent_sup, agent_fsm,
             agent_demo, context_assembler, bridge_manager, bridge_ping,
             pb_codec, state_store, cache, util, mnesia_store, timing_wheel, hermes,
             panel_server]},
  {env, [
      %% Go 侧 Eion-tools server 可执行文件路径
      %% 由 bridge_manager 在 init 时 spawn (erlang:open_port + 4 字节大端长度前缀帧)
      %% Wails 打包时由 release 脚本注入绝对路径, 开发期默认 "eion-tools-server" (在 PATH 中)
      {eion_tools_bin, "eion-tools-server"},
      %% LLM provider 凭证 (由 bridge_manager 注入, 不进入 FSM 状态)
      {api_base, <<"https://api.deepseek.com">>},
      {api_key, <<>>},
      %% 默认模型 (FSM 启动时未指定则用此值)
      {default_model, <<"deepseek-v4-pro">>}
  ]},
  {licenses, ["Apache-2.0"]}
 ]}.
