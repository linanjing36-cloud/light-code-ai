[
 %% lager 日志配置
 %% 控制台输出 info+ 级别; 文件轮转 10MB x 5 份, 每日轮转
 {lager, [
     {log_root, "log"},
     {handlers, [
         {lager_console_backend, info},
         {lager_file_backend, [
             {file, "hermes_brains.log"},
             {level, info},
             {size, 10485760},
             {date, "$D0"},
             {count, 5}
         ]}
     ]}
 ]}
].
