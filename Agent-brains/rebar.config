%% rebar3 配置: Agent-brains 编排大脑
%%
%% 设计要点:
%%   - 业务逻辑只触碰 Erlang Map; pb_codec 模块负责 Map ↔ Protobuf 转换 (防腐层)
%%   - .proto 经 rebar3_gpb 在编译期生成 hermes_pb 模块 (use_maps, strings_as_binaries)
{erl_opts, [debug_info]}.

{deps, [
    %% gpb: Protobuf 编解码库 (运行期依赖)
    {gpb, {git, "https://github.com/tomas-abrahamsson/gpb.git", {tag, "4.21.2"}}},
    %% erlport: 与 Go 侧 IPC 的降级通道 (Port 风格), 分布式节点不可用时回退
    {erlport, {git, "https://github.com/hdima/erlport.git", {tag, "0.10.1"}}}
]}.

%% rebar3_gpb 插件: 编译前从 proto/*.proto 生成 src/hermes_pb.erl
{project_plugins, [rebar3_gpb]}.

{gpb_opts, [
    {proto_dir, "proto"},
    {out_dir, "src"},
    %% 生成的消息以 Erlang Map 表示 (业务侧只碰 Map, 不碰 record)
    {use_maps, true},
    %% 字符串字段以 binary 返回 (避免 Erlang list 的性能/编码开销)
    {strings_as_binaries, true}
]}.

{shell, [
    {apps, [hermes_brains]}
]}.
