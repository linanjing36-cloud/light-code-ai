%% rebar3 配置: Agent-brains 编排大脑
%%
%% 设计要点:
%%   - 业务逻辑只触碰 Erlang Map; pb_codec 模块负责 Map ↔ Protobuf 转换 (防腐层)
%%   - .proto 经 rebar3_gpb_plugin 在编译期生成 hermes_pb 模块 (use_maps, strings_as_binaries)
%% erl_opts:
%%   - {i, "include"} 本项目的 .hrl (gpb 生成的 hermes.hrl)
%%   - {i, "_build/default/lib/gpb/include"} gpb 运行期 .hrl (record field / gpb_oneof)
%%     gpb 生成的 hermes.erl 用 -include("gpb.hrl")，需要把 gpb 的 include 目录加进来
%%   - {encoding, utf8} 源文件按 UTF-8 解析 (允许 <<"...中文...">> 这样的二进制字面量)
{erl_opts, [debug_info,
            {i, "include"},
            {i, "_build/default/lib/gpb/include"},
            {encoding, utf8}]}.

{deps, [
    %% gpb: Protobuf 编解码库 (运行期依赖)
    %% 必须与 rebar3_gpb_plugin 内部使用的 gpb 版本对齐，否则 record 定义不一致
    {gpb, "5.0.0"}
]}.

%% rebar3_gpb_plugin: 编译前从 proto/*.proto 生成 src/hermes_pb.erl
%% (注: hex 上的正确包名是 rebar3_gpb_plugin，不是 rebar3_gpb)
{project_plugins, [rebar3_gpb_plugin]}.

{gpb_opts, [
    %% rebar3_gpb_plugin 用 {i, Dir} 指定 .proto 源目录，{o_erl}/{o_hrl} 指定输出
    {i, "proto"},
    {o_erl, "src"},
    {o_hrl, "include"},
    %% gpb 5.0.0 选项: messages 与 map fields 都用 Erlang Map (业务侧只碰 Map, 不碰 record)
    %% (注: gpb 4.x 的 use_maps 在 5.0 已重命名为 maps)
    maps,
    mapfields_as_maps,
    {maps_unset_optional, omitted},
    {maps_oneof, flat},
    {maps_key_type, atom},
    %% 字符串字段以 binary 返回 (避免 Erlang list 的性能/编码开销)
    strings_as_binaries
]}.

%% 编译前自动跑 protobuf compile 生成 hermes_pb.erl
{provider_hooks, [
    {pre, [
        {compile, {protobuf, compile}}
    ]}
]}.

{shell, [
    {apps, [hermes_brains]}
]}.
