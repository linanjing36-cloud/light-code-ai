%% rebar3 配置: Agent-brains 编排大脑
%%
%% 设计要点:
%%   - 业务逻辑只触碰 Erlang Map; pb_codec 模块负责 Map ↔ Protobuf 转换 (防腐层)
%%   - .proto 经 rebar3_gpb_plugin 在编译期生成 hermes_pb 模块 (use_maps, strings_as_binaries)
%% erl_opts:
%%   - {i, "include"} 本项目的 .hrl (gpb 生成的 hermes.hrl)
%%   - {i, "_build/default/lib/gpb/include"} gpb 运行期 .hrl (record field / gpb_oneof)
%%     gpb 生成的 hermes.erl 用 -include("gpb.hrl")，需要把 gpb 的 include 目录加进来
%%   - {encoding, utf8} 源文件按 UTF-8 解析 (允许 <<"...中文...">> 这样的二进制字面量)
%% src_dirs / project_app_dirs: 不显式配置, 用 rebar3 默认。
%%
%% rebar3 默认递归扫描 src/ 找 .erl 源文件 (官方文档原话: "The src directory
%% is searched recursively and the files are handled as if they were all at
%% the top level")。重排后 src/app/、src/agent/、src/bridge/、src/cache/、
%% src/data_base/、src/util/erl/ 全是 src/ 的子目录, 默认递归扫描即覆盖。
%%
%% 注意: .app.src 的发现规则与 .erl 不同 —— 不是递归扫描!
%% rebar3 只在 src/<appname>.app.src (直接位于 src/ 下, 不在子目录里)
%% 找项目应用清单。所以 hermes_brains.app.src 必须放在 src/ 直接下,
%% 不能放在 src/app/ 子目录 (即使其他 .erl 文件按职责分子目录了)。
%% 之前试过放 src/app/ + 配 src_dirs/project_app_dirs, 都失败:
%%   - src_dirs 显式列出子目录反而关掉了递归扫描, 找不到 .erl
%%   - project_app_dirs=["src/app"] 让 rebar3 找 src/app/src/<name>.app.src (umbrella 模式), 路径不对
%%   - 最后 DEBUG=1 rebar3 compile 看到 "Found top-level apps: []" 确认了根因

{erl_opts, [debug_info,
            {i, "include"},
            {i, "_build/default/lib/gpb/include"},
            {encoding, utf8},
            {parse_transform, lager_transform}]}.

{deps, [
    %% gpb: Protobuf 编解码库 (运行期依赖)
    %% 必须与 rebar3_gpb_plugin 内部使用的 gpb 版本对齐，否则 record 定义不一致
    {gpb, "5.0.0"},
    %% lager: 结构化日志库 (替代 error_logger, 支持日志级别/文件轮转/异步写入)
    {lager, "3.9.2"}
]}.

%% rebar3_gpb_plugin: 编译前从 proto/*.proto 生成 src/hermes_pb.erl
%% (注: hex 上的正确包名是 rebar3_gpb_plugin，不是 rebar3_gpb)
{project_plugins, [rebar3_gpb_plugin]}.

{gpb_opts, [
    %% rebar3_gpb_plugin 用 {i, Dir} 指定 .proto 源目录，{o_erl}/{o_hrl} 指定输出
    %% 重排后 hermes.erl 放在 src/app/ (与 app/ 下其他核心模块同目录)
    {i, "proto"},
    {o_erl, "src/app"},
    {o_hrl, "include"},
    %% gpb 5.0.0 选项: messages 与 map fields 都用 Erlang Map (业务侧只碰 Map, 不碰 record)
    %% (注: gpb 4.x 的 use_maps 在 5.0 已重命名为 maps)
    maps,
    mapfields_as_maps,
    {maps_unset_optional, omitted},
    {maps_oneof, flat},
    {maps_key_type, atom},
    %% 字符串字段以 binary 返回 (避免 Erlang list 的性能/编码开销)
    strings_as_binaries
]}.

%% 编译前自动跑 protobuf compile 生成 hermes_pb.erl
{provider_hooks, [
    {pre, [
        {compile, {protobuf, compile}}
    ]}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [hermes_brains]}
]}.
