{
  "_comment": "本地服务配置模板 (入库). 复制为 local-services.json 后填入真实凭据, local-services.json 已 gitignore.",
  "_usage": "cp config/local-services.example.json config/local-services.json && 编辑填入真实值",

  "vm": {
    "host": "192.168.59.129",
    "ssh": {
      "user": "linanjing",
      "password": "<SSH_PASSWORD>",
      "sudo_password": "<SUDO_PASSWORD>",
      "port": 22
    },
    "os": "Ubuntu Linux (x86_64)"
  },

  "services": {
    "redis": {
      "host": "192.168.59.129",
      "port": 6379,
      "password": "",
      "addr": "192.168.59.129:6379",
      "deployment": "docker",
      "container": "redis-stack",
      "image": "redis/redis-stack-server:latest",
      "insight_port": 8001,
      "insight_url": "http://192.168.59.129:8001",
      "status": "running",
      "auth": "none"
    },

    "mcp": {
      "_note": "VM 上可选部署远程 MCP 服务; 当前 MCP 能力由本地 stdio server 提供",
      "remote": {
        "enabled": false,
        "servers": []
      },
      "local": {
        "codegraph": {
          "name": "codegraph",
          "command": "codegraph",
          "args": ["serve", "--mcp", "--no-watch"],
          "enabled": true,
          "connect_timeout_ms": 60000,
          "retry_delay_ms": 1000
        },
        "mock-mcp": {
          "name": "mock-mcp",
          "command": "go",
          "args": ["run", "./cmd/mock_mcp_stdio"],
          "cwd": "e:/light-code-ai-1/Eion-tools",
          "enabled": true,
          "connect_timeout_ms": 5000,
          "retry_delay_ms": 500
        }
      },
      "env_json": "<HERMES_MCP_SERVERS_JSON 字符串, 见 env_overrides>"
    },

    "agentmemory": {
      "_note": "可选, 项目默认不接入 (与 Agent-brains memory_rag/state_store 职责重叠)",
      "installed": false,
      "install_path": "",
      "status": "stopped"
    }
  },

  "env_overrides": {
    "_comment": "对应的 HERMES_* 环境变量, 可在 PowerShell 会话中 set-item Env: 或传入 make.ps1",
    "HERMES_MEMORY_BACKEND": "redis",
    "HERMES_REDIS_ADDR": "192.168.59.129:6379",
    "HERMES_MEMORY_MOCK_EMBED": "1",
    "HERMES_EMBEDDING_DIM": "1536",
    "HERMES_MCP_SERVERS_JSON": "<JSON 数组字符串, 见 services.mcp.local>"
  }
}
