# =========================================================
# Hermes 项目根 .gitignore
# =========================================================

# ---- 凭据 / 本地调试密钥 (绝对不要进仓库) ----
api-key.json
api-key.local.json
*.secret.json
.env
.env.local
# 本地服务配置 (含 SSH 密码/Redis 密码, 模板 local-services.example.json 入库)
config/local-services.json

# ---- bin/: 本地部署/运行产物 (编译产物 + start/stop 脚本, 均不入库) ----
# 包含: erl_bin/ (make agent), eion_bin/, wails_v3_bin/, start.sh, stop.sh 等
bin/

# =========================================================
# Agent-brains (Erlang/OTP + rebar3)
# =========================================================
Agent-brains/_build/
Agent-brains/rebar.lock
Agent-brains/erl_crash.dump
Agent-brains/rebar3.crashdump
# mnesia 磁盘数据 (运行期生成, 不入库)
# mnesia_store 默认目录: data/mnesia (hermes_brains env mnesia_dir 可覆盖)
Agent-brains/data/
# gpb 在编译期生成，不入库 (源在 proto/hermes.proto)
# 重排后 hermes.erl 输出到 src/app/ (rebar.config gpb_opts {o_erl, "src/app"})
Agent-brains/src/app/hermes.erl
Agent-brains/include/hermes.hrl

# =========================================================
# Eion-tools (Go)
# =========================================================
Eion-tools/bin/
Eion-tools/*.log
# protoc 生成的 Go 代码不入库 (源在 proto/hermes.proto)
Eion-tools/proto/gen/
Eion-tools/hermes.pb.go

# =========================================================
# Wails-v3
# =========================================================
Wails-v3/build/
Wails-v3/frontend/dist/
Wails-v3/*.app/
Wails-v3/extract/

# ---- OS / Editor ----
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# ---- Trae CN 本地配置 / Skill 缓存 (assistant 自用, 不入库) ----
# 包含: .trae-cn/skills/ (superpowers + code-simplifier), session 缓存等
.trae-cn/

# ---- CodeGraph 本地索引 (assistant 自用, 不入库) ----
# .codegraph/ 自身已配 .gitignore 忽略内部产物, 这里再确保目录不进 git
.codegraph/

# ---- 测试日志 (make.ps1 test 产物, 不入库) ----
test-output*.log

# ---- bat 脚本意外输出残留 (scrtps/*.bat 重定向错误产生的文件, 不入库) ----
# 注意: /Wails 只匹配根目录下的 Wails 文件, 不会误匹配 Wails-v3/ 目录
/Wails
/Starting
/epmd
/[force]
Agent-brains/config/mnesia/LATEST.LOG
Agent-brains/log/hermes_brains.log
erl_crash.dump
Agent-brains/config/mnesia/DECISION_TAB.LOG
Agent-brains/config/mnesia/LATEST.LOG
Agent-brains/config/mnesia/ets_snapshot.DCD
Agent-brains/config/mnesia/DECISION_TAB.LOG
